{
  "name": "vellum-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vellum · 素笺 宣传片：用 CDP 抓真实界面素材，再用 Remotion 逐帧合成",
  "license": "MIT",
  "scripts": {
    "sync-fonts": "node scripts/sync-fonts.mjs",
    "capture": "node capture/capture.mjs",
    "capture:zh": "node capture/capture.mjs --lang zh",
    "music": "node audio/make-music.mjs",
    "assets": "npm run sync-fonts && npm run music && npm run capture",
    "dev": "remotion studio",
    "still": "remotion still",
    "render": "remotion render VellumPromo out/vellum-promo.mp4",
    "render:silent": "remotion render VellumPromoSilent out/vellum-promo-silent.mp4",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/fonts": "4.0.524",
    "@remotion/media": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
