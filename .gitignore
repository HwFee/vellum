# Dependencies
node_modules/

# Build outputs
dist/

# Tauri Rust target
target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.sw?

# Local env
.env
.env.local

# Test coverage
coverage/

# tsc -b artifacts (emitted vite.config.js would shadow vite.config.ts)
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

# Windows reserved-name artifacts that break Git on Windows
nul

# Agent runtime: project-local skill junctions, session logs, delegate state
.agents/
# .pi/ 整体不入库（会话、任务、委托状态与别处来的本地技能），唯一例外是 settings.json——
# 它把 pi/ 下的扩展与技能声明为「只在本仓库加载」，是接线本身；实体都在 pi/ 里入库
.pi/*
!.pi/settings.json
.commandcode/
.kimi-code/
.opencode/
.zcode/

# Local run logs / review prompts, never versioned
outputs/
release-artifacts/
