# Dependencies
node_modules/

# Build outputs
dist/

# Tauri Rust target
target/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.sw?

# Local env
.env
.env.local

# Test coverage
coverage/

# tsc -b artifacts (emitted vite.config.js would shadow vite.config.ts)
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

# Windows reserved-name artifacts that break Git on Windows
nul

# Agent runtime: project-local skill junctions, session logs, delegate state
.agents/
# .pi/ 整体不入库，唯一例外是 settings.json——它声明 mdlog 只在本仓库加载
# （extensions: ["../extensions/mdlog"]），是「实体在 extensions/mdlog/、别的项目读不到」的接线本身
.pi/*
!.pi/settings.json
.commandcode/
.kimi-code/
.opencode/
.zcode/

# Local run logs / review prompts, never versioned
outputs/
release-artifacts/
